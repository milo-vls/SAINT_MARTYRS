function Character(_nickname, _firstname, _lastname, _address, _phone_number, _may_appear, _sprite_name_portrait, _room) constructor
{
	nickname = _nickname;
	firstname = _firstname;
	lastname = _lastname;
	address = _address;
	phone_number = _phone_number;
	may_appear = _may_appear;
	sprite_name_portrait = _sprite_name_portrait;
	room = _room;
}