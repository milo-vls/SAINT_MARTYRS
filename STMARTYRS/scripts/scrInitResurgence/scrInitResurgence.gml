
/*
NOTE sur la résurgence:
gd => si res = resMax alors un usi meurt => si meurt pendant récap, on attend la fin du récap pour annoncer la mort de X  usi, sinon on le fait directement.



*/
function init_resurgence()
{

resurgenceMax = 100;
resurgence = 0;

nbUsiToDie = 0



}

function reach_max_res()
{
ojeu.nbUsiToDie ++
ojeu.resurgence -= 70;
}